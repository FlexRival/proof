# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas claves al repo.
#
# --- Supabase (Project Settings > API) ---
#
# La clave publicable está pensada para viajar dentro de la app: quien protege
# los datos son las políticas RLS, no el secreto de la clave. La clave de
# servicio (service_role) se salta RLS entera y NO va aquí ni en ningún archivo
# del cliente.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- RevenueCat (Project > API keys) ---
#
# Son las claves PÚBLICAS del SDK, una por plataforma ("Apple" y "Google" en el
# dashboard). Están pensadas para viajar dentro de la app: NO son la "Secret API
# key" (esa vive en los secretos de Supabase para las Edge Functions revenuecat-*,
# ver supabase/SCHEMA.md §15 y docs/revenuecat.md).
#
# Si faltan, la app arranca igual y el paywall se muestra como "no disponible".

EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
